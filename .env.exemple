# Environment variables for local development.
# Replace placeholder values with your actual credentials before running the app.

#########################
# Required configuration #
#########################

NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="public-anon-key"

############################
# Authentication (required) #
############################

# Auth0: keep website and MCP clients/audiences distinct.
AUTH0_DOMAIN=""
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
AUTH0_SECRET=""
APP_BASE_URL="http://localhost:3000"
AUTH0_WEB_AUDIENCE="https://razmaz-live-stocks.vercel.app/api/web"
AUTH0_MCP_CLIENT_ID=""
AUTH0_MCP_AUDIENCE="https://razmaz-live-stocks.vercel.app/api/mcp"
# Server-only; never prefix these with NEXT_PUBLIC_. Generate independent keys.
SUPABASE_SERVICE_ROLE_KEY=""
CREDENTIAL_ENCRYPTION_KEY=""
AUTH0_MANAGEMENT_CLIENT_ID=""
AUTH0_MANAGEMENT_CLIENT_SECRET=""

# Explicitly approved public operator details; /about, /privacy and /terms return 503 until both are set.
# These values are displayed publicly. Do not copy private OAuth contact details without approval.
PUBLISHER_NAME=""
PUBLIC_SUPPORT_EMAIL=""

# Optional market calculation configuration (no shared Finnhub fallback).
DEFAULT_GROWTH_RATE=0.06
DEFAULT_USD_TO_ILS_RATE=3.3
EXCHANGE_RATE_URL="https://open.er-api.com/v6/latest/USD"
OPENAI_API_KEY=""
