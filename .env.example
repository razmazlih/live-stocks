# Google-only launch. Email/password features require explicit opt-in and configured delivery.
PASSWORD_AUTH_ENABLED=false
# Temporary issuer-setup gate; disable only after migration and verification.
LIVESTOCKS_MAINTENANCE=false
# Own-site Better Auth. Never commit real values. No production cutover is implied.
# For an existing hosted account, keep the canonical deployed origin here.
# npm run dev supplies LOCAL_AUTH_ORIGIN automatically for the actual local port.
# LOCAL_AUTH_ORIGIN is permitted only in development and only for HTTP loopback.
APP_BASE_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Dedicated role only; never use postgres/service-role credentials here.
BETTER_AUTH_DATABASE_URL=postgresql://livestocks_auth_backend:REPLACE@127.0.0.1:5432/postgres
# Optional PEM CA for hosted PostgreSQL; certificate verification remains enabled.
BETTER_AUTH_DATABASE_CA=
BETTER_AUTH_WEBSITE_CLIENT_ID=livestocks-web
BETTER_AUTH_MCP_CLIENT_ID=livestocks-mcp
BETTER_AUTH_MCP_CLIENT_SECRET=

# SMTP is required for signup verification, verification resend and password reset.
# Without all five values these operations fail explicitly; no email is claimed sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Optional Google OAuth. Configure this exact callback for APP_BASE_URL:
# https://YOUR_ORIGIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Existing Supabase data APIs. The issuer/JWKS integration also needs separate setup.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only 64-character hexadecimal key, also used for verified identity hashing.
CREDENTIAL_ENCRYPTION_KEY=

# Auth0 is retained for isolated legacy-identity proof/migration only.
# These variables do not enable the new website login provider.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_WEBSITE_AUDIENCE=
AUTH0_MCP_AUDIENCE=
AUTH0_MCP_CLIENT_ID=

# General two-profile merging: keep disabled until browser proof/recovery and worker gates pass.
ACCOUNT_LINKING_ENABLED=false
# Server-only, independent random 32+ character secret for POST /api/internal/account-merge-worker.
# Configure a bounded scheduler/operator recovery before enabling. Never prefix NEXT_PUBLIC_.
ACCOUNT_LINKING_WORKER_SECRET=
