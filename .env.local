# Environment variables for local development.
# Replace placeholder values with your actual credentials before running the app.

#########################
# Required configuration #
#########################
# REQUIRED — Supabase project URL used by the client.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"

# REQUIRED — Supabase anon key for authenticated requests.
NEXT_PUBLIC_SUPABASE_ANON_KEY="public-anon-key"

##########################
# Optional configuration #
##########################
# OPTIONAL (recommended) — Personal Finnhub token to avoid rate limits.
FINNHUB_TOKEN=""

# OPTIONAL — Override the default annual growth rate used in forecasts (0.05).
DEFAULT_GROWTH_RATE=0.05

# OPTIONAL — Override the fallback USD→ILS exchange rate (3.7) if the API fails.
DEFAULT_USD_TO_ILS_RATE=3.7

# OPTIONAL — Custom exchange-rate API endpoint; default keeps using open.er-api.com.
EXCHANGE_RATE_URL="https://open.er-api.com/v6/latest/USD"

# OPTIONAL — Base URL for the forecast microservice; leave blank to disable forecasts.
NEXT_PUBLIC_FORECAST_URL="http://localhost:8080"

# OPTIONAL — Enables Supabase Studio AI features when provided.
OPENAI_API_KEY=""
